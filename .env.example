# GA4 measurement ID (must be NEXT_PUBLIC_ to be readable in the browser).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: override where the SQLite file lives (defaults to ./data).
# DB_DIR=/var/data/khabaradda

# Admin review screen (/admin) — single shared password, required for /admin
# and /api/admin/* to work at all. Pick something long and random.
ADMIN_PASSWORD=change-me

# "Draft with AI" provider (Milestone 3). AI_PROVIDER selects the
# implementation in lib/ai/draft.ts; only "openai" exists today.
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
